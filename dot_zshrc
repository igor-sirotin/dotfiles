for file in ~/.zshrc.d/*.sh(N); do
    source "$file"
done

# Build fpath first, then run compinit exactly once — it is the slowest part of
# zsh startup, and anything appended to fpath after it runs is not picked up.
# $HOMEBREW_PREFIX is set in .zshrc.d/paths.sh, sourced by the loop above.
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi

# Docker Desktop CLI completions.
if [[ -d "$HOME/.docker/completions" ]]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# A bare `compinit` stat()s every file in every fpath directory to audit
# ownership, then rewrites the dump. With Homebrew's completions on fpath that
# is the single most expensive step in zsh startup. Do the full audit at most
# once a day and load the cached dump with -C in between.
#
# The check has to be an array assignment: `(Nmh-24)` means "exists and was
# modified less than 24h ago", but glob qualifiers only expand where filename
# generation happens. The widely-copied `[[ -n ~/.zcompdump(#qNmh-24) ]]` does
# no globbing inside [[ ]], so it is always true and silently never refreshes.
autoload -Uz compinit
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
_zcompdump_fresh=("$_zcompdump"(Nmh-24))
if (( $#_zcompdump_fresh )); then
    compinit -C -d "$_zcompdump"
else
    compinit -d "$_zcompdump"
    # compinit only rewrites the dump when the set of completions changed, so on
    # an unchanged system the mtime would stay old and every future shell would
    # take this slow branch. Stamp it explicitly to restart the 24h clock.
    touch "$_zcompdump"
    # Precompile so the next shell mmaps bytecode instead of reparsing the dump.
    # Must follow the touch: zsh ignores a .zwc older than its source file.
    [[ -s "$_zcompdump" ]] && zcompile -R -- "$_zcompdump"
fi
unset _zcompdump _zcompdump_fresh
