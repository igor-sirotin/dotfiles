{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh

set -eu

if ! command -v apt-get >/dev/null 2>&1; then
    echo "install-packages: no apt-get here, install the packages by hand" >&2
    exit 0
fi

sudo=
[ "$(id -u)" -eq 0 ] || sudo=sudo

$sudo apt-get update

apt_packages="ca-certificates curl direnv git tree vim
{{- if eq (includeTemplate "login-shell-is-zsh" .) "true" }} zsh-autosuggestions{{ end }}"
downloads="starship"
# lsd and vivid are only in apt from Ubuntu 24.04.
for package in lsd vivid; do
    if apt-cache show "$package" >/dev/null 2>&1; then
        apt_packages="$apt_packages $package"
    else
        downloads="$downloads $package"
    fi
done

# shellcheck disable=SC2086
$sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    $apt_packages

case "$(uname -m)" in
    x86_64) arch=x86_64 ;;
    aarch64 | arm64) arch=aarch64 ;;
    *)
        echo "install-packages: no pinned builds for $(uname -m)" >&2
        exit 1
        ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# lsd and vivid publish no checksums; theirs were computed from the archives.
for tool in $downloads; do
    case "$tool-$arch" in
        starship-x86_64)
            url=https://github.com/starship/starship/releases/download/v1.27.0/starship-x86_64-unknown-linux-musl.tar.gz
            sha256=10c8eb4cb3b761d9bf59ea828444c2dab36c900b7d69a69e08814b286969df89
            member=starship
            ;;
        starship-aarch64)
            url=https://github.com/starship/starship/releases/download/v1.27.0/starship-aarch64-unknown-linux-musl.tar.gz
            sha256=341f5cbf24699fa0b27ec88965ad25f862ea09e15d35a543fd6ffdff1d2aa00d
            member=starship
            ;;
        lsd-x86_64)
            url=https://github.com/lsd-rs/lsd/releases/download/v1.2.0/lsd-v1.2.0-x86_64-unknown-linux-musl.tar.gz
            sha256=77849da1210336534258551a581401ba19ae6b8d7b66a2a1feff148ad41e3814
            member=lsd-v1.2.0-x86_64-unknown-linux-musl/lsd
            ;;
        lsd-aarch64)
            url=https://github.com/lsd-rs/lsd/releases/download/v1.2.0/lsd-v1.2.0-aarch64-unknown-linux-musl.tar.gz
            sha256=642ecb1a763b9f790a99c83a1445c117a6813ed4edb5d498d4420423c6353eb8
            member=lsd-v1.2.0-aarch64-unknown-linux-musl/lsd
            ;;
        vivid-x86_64)
            url=https://github.com/sharkdp/vivid/releases/download/v0.11.1/vivid-v0.11.1-x86_64-unknown-linux-musl.tar.gz
            sha256=f1a80a39c75ceae43c4187f302e66c0a45d941ed1479456a0d5ddef665663181
            member=vivid-v0.11.1-x86_64-unknown-linux-musl/vivid
            ;;
        vivid-aarch64)
            url=https://github.com/sharkdp/vivid/releases/download/v0.11.1/vivid-v0.11.1-aarch64-unknown-linux-gnu.tar.gz
            sha256=99bf6438b3403bc9255a83363fe5ed49a0f8bd86377a561420836af14dc8e9ee
            member=vivid-v0.11.1-aarch64-unknown-linux-gnu/vivid
            ;;
    esac
    curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp/$tool.tar.gz" "$url"
    echo "$sha256  $tmp/$tool.tar.gz" | sha256sum -c - >/dev/null
    tar -xzf "$tmp/$tool.tar.gz" -C "$tmp" "$member"
    install -D -m 0755 "$tmp/$member" "$HOME/.local/bin/$tool"
done
{{ end -}}
